# Copy to .env and edit. Anything left out uses the default shown here.

# First version is paper trading only. False is refused (live execution not implemented).
PAPER_MODE=True

# Fixed stake per traded round. No martingale / no increases.
STAKE_INR=1100
MAX_STAKE_INR=1100
MAX_DAILY_LOSS_INR=5000

# Paper wallet: trades need free balance, and the dashboard values open trades at live prices
STARTING_BALANCE_INR=100000
# Largest single manual order from the dashboard (fat-finger guard)
MAX_MANUAL_ORDER_INR=25000
# If set, dashboard buttons (buy, sell, exits, auto-trader) need this key. Set it whenever the
# dashboard is reachable by others (Heroku, a tunnel, PythonAnywhere).
# DASHBOARD_KEY=pick-a-long-random-string

# Polymarket settles in USDC. Used to convert the ₹ stake and P/L. Update it now and then.
INR_PER_USD=96

# Paper-fill realism
MAX_ENTRY_PRICE=0.99      # never buy above 99¢ a share
TAKER_FEE_RATE=0.07       # Polymarket crypto taker fee: fee = shares * rate * p * (1 - p)

# Timing
POLL_SECONDS=2
NO_TRADE_LAST_SECONDS=3
MAX_BOOK_AGE_SECONDS=15
MAX_PROB_SUM_DEVIATION=5

# Day boundary for the daily loss limit
TIMEZONE=Asia/Kolkata

# Optional browser window showing the current round (read-only, never clicks trade buttons)
BROWSER_ENABLED=False
BROWSER_HEADLESS=False
BROWSER_CROSSCHECK=False
BROWSER_TOLERANCE_PCT=2
# BROWSER_EXECUTABLE=C:\Program Files\Google\Chrome\Application\chrome.exe
